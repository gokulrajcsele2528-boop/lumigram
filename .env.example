# Database
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.mongodb.net/lumigram?retryWrites=true&w=majority

# JWT Secrets (Use strong random 64+ char strings in production)
JWT_ACCESS_SECRET=lumigram_access_secret_super_secure_key_at_least_32_chars_2026
JWT_REFRESH_SECRET=lumigram_refresh_secret_super_secure_rotating_key_32_chars_2026

# App URL / CORS
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lumigram.app@gmail.com
SMTP_PASS=app_password_here
EMAIL_FROM=Lumigram <noreply@lumigram.com>

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cloudflare Turnstile CAPTCHA (Optional bot protection)
TURNSTILE_SITE_KEY=0x4AAAAAAAx_sample_site_key
